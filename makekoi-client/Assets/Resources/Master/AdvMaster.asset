    Message: "\u4ECA\u65E5\u306E\u3042\u306A\u305F\u3001\u5C11\u3057\u304B\u3063\u3053\u3088\u304B\u3063\u305F\u3067\u3059\u3088\u3002\n\u6B21\u306E\u30C7\u30FC\u30C8\u3001\u697D\u3057\u307F\u306B\u3057\u3066\u307E\u3059\u3002"
  - Code: RESULT_REACTION_GREAT
    Gender: 1
